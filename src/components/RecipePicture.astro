---
import { Image } from 'astro:assets';

interface Props {
  image?: ImageMetadata;
  title: string;
  placeholderText: string;
  class?: string;
  sizes?: string;
}

const {
  image,
  title,
  placeholderText,
  class: className,
  sizes = '(min-width: 768px) 340px, 100vw',
} = Astro.props;
---

{
  image ? (
    <Image
      src={image}
      alt={title}
      widths={[230, 340, 460, 680, 920, 1254]}
      sizes={sizes}
      quality="high"
      class:list={['block rounded-lg object-contain', className]}
    />
  ) : (
    <div
      aria-hidden="true"
      class:list={[
        'grid place-content-center rounded-lg bg-accent-2-100 p-4 text-center',
        className,
      ]}
    >
      <span class="font-heading text-lg text-ink/40">{placeholderText}</span>
    </div>
  )
}
