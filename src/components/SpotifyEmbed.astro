---
interface Props {
  trackId: string;
  label: string;
}

const { trackId, label } = Astro.props;
---

<div class="rounded-2xl bg-ink p-4 text-bg shadow-elev-sm">
  <h3 class="mb-2 font-heading text-base text-accent-2">{label}</h3>
  <iframe
    class="block w-full rounded-[14px]"
    src={`https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`}
    width="100%"
    height="152"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"></iframe>
</div>
