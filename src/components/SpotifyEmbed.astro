---
interface Props {
  trackId: string;
  label: string;
}

const { trackId, label } = Astro.props;
---

<div>
  <h3 class="relative z-10 mb-[-5px] ml-3 inline-block rounded-t-lg bg-accent px-3 pt-1.5 pb-[9px] font-heading text-sm text-white">
    {label}
  </h3>
  <iframe
    class="relative z-0 block w-full rounded-lg"
    src={`https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`}
    width="100%"
    height="152"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy"></iframe>
</div>
