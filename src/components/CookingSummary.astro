---
import type { CookingInfo, Locale } from '../data/recipes/types';
import { ui } from '../data/ui';

interface Props {
  cooking: CookingInfo;
  locale: Locale;
}

const { cooking, locale } = Astro.props;
const t = ui[locale];
const timing = cooking.timing;
const range = timing.kind === 'duration' && timing.maxMinutes !== undefined
  ? `${timing.minutes}-${timing.maxMinutes}`
  : `${timing.minutes}`;
const duration = `${range} ${t.minutes}`;
const timeLabel = timing.kind === 'check'
  ? t.checkCookingAfter.replace('{time}', duration)
  : timing.approximate ? `${t.approximately} ${duration}` : duration;
---

<section
  aria-labelledby="cooking-heading"
  class="rounded-2xl border border-accent-200/60 bg-surface p-6 shadow-elev-sm"
>
  <div class="flex flex-wrap items-center gap-3">
    <div class="flex h-12 w-12 shrink-0 -rotate-6 items-center justify-center rounded-[18px] bg-accent-100 text-accent-700" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 7c-2-2 2-3 0-5m10 5c-2-2 2-3 0-5m10 5c-2-2 2-3 0-5" opacity=".55" />
        {cooking.method === 'airFryer' ? <>
          <path d="M14 10h12c5 0 7 4 7 9v12c0 3-2 5-5 5H12c-3 0-5-2-5-5V19c0-5 2-9 7-9Z" fill="var(--color-surface)" />
          <circle cx="20" cy="16" r="2.5" />
          <path d="M7 23h26M17 23v5h6v-5M11 36v1m18-1v1" />
        </> : <>
          <path d="M6 12c0-1 1-2 2-2h24c1 0 2 1 2 2v21c0 1-1 2-2 2H8c-1 0-2-1-2-2Z" fill="var(--color-surface)" />
          <path d="M6 18h28M10 35v2m20-2v2" />
          <circle cx="11" cy="14" r=".8" fill="currentColor" />
          <circle cx="16" cy="14" r=".8" fill="currentColor" />
          <path d="M25 14h5M12 22h16v9H12Zm4 3h8" />
        </>}
      </svg>
    </div>
    <h2 id="cooking-heading" class="m-0 font-heading text-[26px]">{t.cooking}</h2>
    <span class="ml-auto rounded-full border border-accent-200 bg-accent-100/60 px-3 py-1 text-xs font-semibold text-accent-700">{t[cooking.method]}</span>
  </div>
  <dl class="m-0 mt-5 grid grid-cols-2 gap-3">
    <div class="flex flex-col rounded-xl bg-accent-100/65 px-4 py-3">
      <dt class="flex items-start gap-1.5 text-xs font-semibold leading-snug text-accent-800">
        <svg class="mt-px shrink-0" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M8 11V4a2 2 0 0 1 4 0v7a4 4 0 1 1-4 0Z" /><path d="M10 7v7" /><circle cx="10" cy="14" r="1" fill="currentColor" /></svg>
        {t.temperature}
      </dt>
      <dd class="m-0 mt-auto pt-2 font-heading text-[26px] leading-tight text-accent-700">{cooking.temperatureC} <span class="text-lg">°C</span></dd>
    </div>
    <div class="flex flex-col rounded-xl bg-accent-2-100 px-4 py-3" aria-label={timeLabel}>
      <dt class="flex items-start gap-1.5 text-xs font-semibold leading-snug text-accent-2-800">
        <svg class="mt-px shrink-0" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="11" r="6.5" /><path d="M8 1h4m-2 0v3m5 1 1.5-1.5M10 7v4l2 1" /></svg>
        {timing.kind === 'check' ? t.firstCheck : t.cookingDuration}
      </dt>
      <dd class="m-0 mt-auto pt-2 font-heading text-[22px] leading-tight text-accent-2-700 sm:text-[26px]">
        {timing.kind === 'duration' && timing.approximate && <span class="block pb-1 font-body text-xs font-semibold">{t.approximately}</span>}
        {range} <span class="text-sm sm:text-lg">{t.minutes}</span>
      </dd>
    </div>
  </dl>
  {cooking.note && <p class="m-0 mt-4 flex items-baseline gap-2 text-sm text-ink/75"><span aria-hidden="true" class="text-accent">✳</span>{cooking.note[locale]}</p>}
</section>
