---
// Netlify redirects / before this page is served. This small client-side
// fallback keeps local and non-Netlify hosts consistent.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Rollercoaster Recipes</title>
    <script>
      const supportedLocales = ['en', 'tr', 'es'];
      const savedLocale = document.cookie.match(/(?:^|;\\s*)rr_locale=(en|tr|es)(?:;|$)/)?.[1];

      const browserLocale = navigator.languages
        .map((language) => language.split('-')[0])
        .find((language) => supportedLocales.includes(language));
      const locale = supportedLocales.includes(savedLocale ?? '') ? savedLocale : browserLocale ?? 'en';
      location.replace(`/${locale}`);
    </script>
    <style>
      html {
        background: #f9e9d1;
        color: #1e144b;
      }
      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-content: center;
        gap: 16px;
        text-align: center;
        font-family: system-ui, sans-serif;
      }
      h1 {
        margin: 0;
        font-size: 28px;
      }
      nav {
        display: flex;
        gap: 16px;
        justify-content: center;
      }
      a {
        color: #9c4306;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <h1>Rollercoaster Recipes</h1>
    <nav data-language-picker>
      <a href="/en" data-locale="en">English</a>
      <a href="/tr" data-locale="tr">Türkçe</a>
      <a href="/es" data-locale="es">Español</a>
    </nav>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-language-picker] a[data-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          const locale = link.dataset.locale ?? 'en';
          const secure = location.protocol === 'https:' ? '; Secure' : '';
          document.cookie = `rr_locale=${locale}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`;
        });
      });
    </script>
  </body>
</html>
